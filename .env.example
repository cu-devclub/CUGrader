# CUGrader Environment Configuration Example

# Development / Production
SERVICE_ENV=development

# Authentication & Security
PORT=5000
JWT_KEY=cugrader-default-jwt-secret-key-32chars!
COOKIE_SECRET=dev-cookie-secret-cugrader
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/callback
FRONTEND_URL=http://localhost:3000

# Optional: PEM encoded RSA keys (auto-generated in dev mode if omitted)
# PRIVATE_KEY=
# PUBLIC_KEY=

# Database & Message Broker Connection Strings (dev defaults work with docker compose)
MONGO_URI=mongodb://root:12345678@mongodb:27017/cugrader?authSource=admin
RABBIT_URI=amqp://guest:guest@rabbitmq:5672/
YSQL_DSN=postgres://yugabyte:yugabyte@yugabyte:5433/cugrader?sslmode=disable

# Credentials for Production
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=12345678
YSQL_USER=yugabyte
YSQL_PASSWORD=yugabyte
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword
